<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://fxml.com/fxml/1">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <TextField fx:id="display" editable="false" prefHeight="40.0" style="-fx-font-size: 16px;" text="0" />
    
    <GridPane hgap="5.0" vgap="5.0">
        <Button text="7" prefWidth="50" prefHeight="50" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Button text="8" prefWidth="50" prefHeight="50" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Button text="9" prefWidth="50" prefHeight="50" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <Button text="/" prefWidth="50" prefHeight="50" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
        
        <Button text="4" prefWidth="50" prefHeight="50" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Button text="5" prefWidth="50" prefHeight="50" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Button text="6" prefWidth="50" prefHeight="50" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <Button text="*" prefWidth="50" prefHeight="50" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
        
        <Button text="1" prefWidth="50" prefHeight="50" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Button text="2" prefWidth="50" prefHeight="50" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Button text="3" prefWidth="50" prefHeight="50" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <Button text="-" prefWidth="50" prefHeight="50" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
        
        <Button text="C" prefWidth="50" prefHeight="50" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Button text="0" prefWidth="50" prefHeight="50" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Button text="=" prefWidth="50" prefHeight="50" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
        <Button text="+" prefWidth="50" prefHeight="50" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
    </GridPane>
</VBox>